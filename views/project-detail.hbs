{{> header}}

<div class="container my-5">
    <div class="back-button mb-4">
        <a href="/myproject" class="btn btn-outline-secondary">← Kembali ke List Project</a>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card detail-card shadow">
                {{#if project.img}}
                <img src="{{project.img}}" class="project-image-detail" alt="{{project.name}}">
                {{/if}}
                <div class="card-body p-4">
                    <h1 class="card-title mb-3">{{project.name}}</h1>
                    
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h5>📅 Durasi Project</h5>
                            <p class="text-muted">{{calculateDuration project.start project.end}}</p>
                        </div>
                        <div class="col-md-6">
                            <h5>📋 Periode</h5>
                            <p class="text-muted">
                                {{formatDate project.start}} - {{formatDate project.end}}
                            </p>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h5>🛠️ Teknologi yang Digunakan</h5>
                        <div class="mt-2">
                            {{#each project.techs}}
                            <span class="badge bg-primary tech-badge">{{this}}</span>
                            {{/each}}
                        </div>
                    </div>

                    <div class="mb-4">
                        <h5>📝 Deskripsi Project</h5>
                        <p class="lead">{{project.desc}}</p>
                    </div>

                    <div class="d-flex gap-2">
                        <a href="/myproject" class="btn btn-warning">Edit Project</a>
                        <button class="btn btn-danger" onclick="deleteProject({{project.id}})">Hapus Project</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>